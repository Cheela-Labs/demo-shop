# Server-side secrets. Git-ignored — do not commit, and never expose to the
# browser. The Cheela CLI reads this file automatically.

# Deploy key (ch_sk_...). Used by `cheela deploy` / `cheela status`.
CHEELA_API_KEY=ch_sk_...

# Runtime secret, shown once when the runtime is registered in the dashboard.
# The server verifies the HMAC on every incoming capability call with it.
# Until it is set, /cheela/execute returns 503 rather than trusting unsigned
# requests.
CHEELA_RUNTIME_SECRET=

# Optional: reject signatures issued for a different runtime id.
CHEELA_RUNTIME_ID=

# Public HTTPS URL where Cheela can reach /cheela/execute. Cheela calls *in*, so
# localhost needs a tunnel in development:
#   npx cloudflared tunnel --url http://localhost:4000
# Prefer cloudflared over localtunnel — localtunnel is slow enough that Cheela
# times the callback out (HTTP 408).
CHEELA_ENDPOINT=

# URLs used to build image and CTA links inside capability results.
PUBLIC_BASE_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:5173

# --- Razorpay -------------------------------------------------------------
# Test keys from https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Leave unset and the shop falls back to the simulated processor, so checkout
# and every test still work on a clean clone.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you create the webhook in the dashboard. NOT the API secret — a
# different value, and using the API secret here fails every signature check.
# Point the webhook at: <public-url>/webhooks/razorpay
# Subscribe to: payment.captured, payment.failed, payment_link.paid
RAZORPAY_WEBHOOK_SECRET=

# Sandbox: run the whole Razorpay flow without sending anything to Razorpay.
# Useful before the account's business/web-app details are filled in, which
# otherwise makes every real payment fail for reasons unrelated to this code.
# Signatures are still signed and verified with the real keys above.
# Refused outright when NODE_ENV=production.
RAZORPAY_SIMULATE=
