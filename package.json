{
  "name": "cheela-shop",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "A small but complete ecommerce site (React + Express) with procedurally generated SVG product art.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "smoke": "node scripts/smoke.mjs",
    "smoke:addresses": "node scripts/address-smoke.mjs",
    "smoke:cheela": "node --env-file-if-exists=server/.env scripts/cheela-smoke.mjs",
    "smoke:cart": "node --env-file-if-exists=server/.env scripts/shared-cart-smoke.mjs",
    "smoke:actions": "node --env-file-if-exists=server/.env scripts/actions-smoke.mjs",
    "smoke:razorpay": "node --env-file-if-exists=server/.env scripts/razorpay-smoke.mjs",
    "smoke:sandbox": "node scripts/razorpay-sandbox.mjs",
    "razorpay:drive": "node --env-file-if-exists=server/.env scripts/razorpay-drive.mjs",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "cheela:dev": "npm run cheela:dev --workspace server",
    "cheela:deploy": "npm run cheela:deploy --workspace server",
    "cheela:status": "npm run cheela:status --workspace server",
    "cheela:deploy:dry": "npm run cheela:deploy:dry --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
